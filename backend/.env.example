# ==============================================================================
# VAANI-RAKSHAK Backend — Environment Configuration Template
# Copy to .env and fill in values for your environment.
# NEVER commit the real .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_ENV=development                # development | staging | production
APP_VERSION=0.1.0
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false                     # true = JSON lines, false = pretty console

# ------------------------------------------------------------------------------
# API Server
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# Payload limits
MAX_AUDIO_SIZE_MB=50

# ------------------------------------------------------------------------------
# Detection Mode
# DETECTION_MODE controls which adapter implementations are loaded.
#   mock   — All detectors are deterministic stubs (Phase 0/1 default)
#   onnx   — Real ONNX model adapters (requires R1 model artifacts)
# ------------------------------------------------------------------------------
DETECTION_MODE=mock

# ------------------------------------------------------------------------------
# Kafka
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_TOPIC_PREFIX=vaani
# KAFKA_SASL_MECHANISM=PLAIN        # Uncomment for authenticated brokers
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# Producer settings
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=3
KAFKA_PRODUCER_LINGER_MS=5

# Consumer settings
KAFKA_CONSUMER_GROUP_ID=vaani-pipeline
KAFKA_CONSUMER_AUTO_OFFSET_RESET=latest

# ------------------------------------------------------------------------------
# Pipeline / Cascade Thresholds
# These are development defaults — NOT validated production thresholds.
# Calibrate against real data before any production deployment.
# ------------------------------------------------------------------------------
TIER0_EARLY_EXIT_LOW=0.22          # Below this → skip Tier 1, mark LOW
TIER0_EARLY_EXIT_HIGH=0.75         # Above this → always escalate
TIER1_ESCALATE_THRESHOLD=0.50      # Above this → escalate to Tier 2
TIER_DISAGREEMENT_DELTA=0.30       # Score gap that triggers Tier 2

HIGH_STAKES_TRANSACTION_INR=200000 # Transactions above this always run Tier 2

# Mock adapter scenario (for deterministic testing)
# Values: LOW_RISK | MEDIUM_RISK | HIGH_RISK | CRITICAL_RISK |
#         TIER_DISAGREEMENT | MODEL_TIMEOUT | MODEL_FAILURE | SPEAKER_MISMATCH
MOCK_SCENARIO=LOW_RISK

# ------------------------------------------------------------------------------
# Risk Engine Thresholds
# Development defaults — NOT production-validated.
# ------------------------------------------------------------------------------
RISK_LOW_MAX=29
RISK_MEDIUM_MAX=59
RISK_HIGH_MAX=79
# CRITICAL: > RISK_HIGH_MAX (i.e. >= 80)

OOB_HIGH_STAKES_THRESHOLD=55      # OOB required if risk >= this AND high-stakes
OOB_DEFAULT_THRESHOLD=70          # OOB required if risk >= this

# ------------------------------------------------------------------------------
# Model Paths (Phase 1+ — unused in Phase 0)
# Uncomment and set when R1 artifacts are available.
# ------------------------------------------------------------------------------
# TIER0_MODEL_PATH=models/tier0.onnx
# TIER1_MODEL_PATH=models/aasist_l.onnx
# TIER2_MODEL_PATH=models/indic_wav2vec_aasist3.onnx
# SPEAKER_MODEL_PATH=models/ecapa_tdnn.onnx
# LID_MODEL_PATH=models/indic_lid.onnx
# FUSION_MODEL_PATH=models/lightgbm_fusion.bin

# ------------------------------------------------------------------------------
# Audit Ledger (Phase 8 — R4 interface)
# AUDIT_MODE controls which audit adapter is used.
#   mock    — in-memory logging only (default)
#   fabric  — Hyperledger Fabric (requires R4 infrastructure)
# ------------------------------------------------------------------------------
AUDIT_MODE=mock
# FABRIC_CHANNEL=vaani-channel
# FABRIC_CHAINCODE=vaani-audit
# FABRIC_GATEWAY_URL=

# ------------------------------------------------------------------------------
# Telephony Simulation (Phase 7)
# ------------------------------------------------------------------------------
TELEPHONY_MODE=simulated           # simulated | freeswitch | kamailio
SIMULATED_SEGMENT_DURATION_MS=2000
SIMULATED_SAMPLE_RATE=16000

# ------------------------------------------------------------------------------
# Reliability, Security & Hardening (Phase 9)
# ------------------------------------------------------------------------------
MAX_REQUEST_SIZE_MB=50             # Maximum HTTP request body size (rejects with 413)
MAX_AUDIO_CHUNK_SIZE_MB=10         # Maximum single audio segment/chunk size in MB

RATE_LIMIT_REQUESTS_PER_MINUTE=120 # In-memory sliding token bucket request rate per IP
RATE_LIMIT_BURST_CAPACITY=30       # Burst request capacity

WS_MAX_MESSAGE_SIZE_MB=5           # Max WebSocket message payload in MB
WS_MAX_MESSAGES_PER_SECOND=20      # Max messages per second per WebSocket client
WS_MAX_CONNECTIONS_PER_CLIENT=10   # Max concurrent WebSocket connections per IP

ENABLE_HSTS=false                  # Set true in production behind HTTPS (Strict-Transport-Security)

CIRCUIT_BREAKER_FAILURE_THRESHOLD=5       # Consecutive failures before opening circuit
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SEC=30.0 # Time to remain open before half-open trial
CIRCUIT_BREAKER_HALF_OPEN_MAX_TRIALS=3    # Successful probe requests required to close

SLOW_REQUEST_THRESHOLD_MS=500.0    # Threshold for logging slow request warnings

# ------------------------------------------------------------------------------
# Security (Future — architecture is auth-ready)
# Uncomment when authentication is wired up.
# ------------------------------------------------------------------------------
# AUTH_ENABLED=false
# JWT_SECRET=change-me-in-production
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=60
